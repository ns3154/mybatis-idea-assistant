<idea-plugin>
    <id>io.github.ns3154.mybatis-idea-assistant</id>
    <name>MyBatis Assistant</name>
    <vendor url="https://github.com/ns3154/mybatis-idea-assistant">ns3154</vendor>

    <description><![CDATA[
        <p>MyBatis Assistant provides conservative MyBatis navigation, inspection, and incremental semantic models for IntelliJ IDEA.</p>
        <p>当前开发预览版提供双向精确导航、XML/Java/Kotlin K2 引用、参数路径与 ResultMap 属性解析、TypeAlias 引用、保守检查、安全 Quick Fix 与原生重命名、可增量失效的符号化动态 SQL 编译和字符级 source map、OGNL 语言支持、Spring 显式注入导航、Plus/Flex/TkMapper 统一模型、六数据库方言、可选 Database Tools 与 Community JDBC 元数据、表列补全与低误报 schema 检查、带全量预览和稳定生成区的数据库代码生成，以及保守转换、幂等格式化、日志 SQL 还原、受控执行与 JUnit 测试骨架。</p>
    ]]></description>

    <extensionPoints>
        <extensionPoint
                name="databaseMetadataProvider"
                interface="io.github.ns3154.mybatisassistant.database.MyBatisDatabaseMetadataProvider"
                dynamic="true"/>
    </extensionPoints>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends optional="true" config-file="io.github.ns3154.mybatisassistant-withKotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="io.github.ns3154.mybatisassistant-withSpring.xml">com.intellij.spring</depends>
    <depends optional="true" config-file="io.github.ns3154.mybatisassistant-withYaml.xml">org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="io.github.ns3154.mybatisassistant-withDatabase.xml">com.intellij.database</depends>

    <resource-bundle>messages.MyBatisAssistantBundle</resource-bundle>

    <extensions defaultExtensionNs="io.github.ns3154.mybatis-idea-assistant">
        <databaseMetadataProvider
                implementation="io.github.ns3154.mybatisassistant.database.jdbc.MyBatisJdbcMetadataProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <lang.parserDefinition
                language="MyBatisOGNL"
                implementationClass="io.github.ns3154.mybatisassistant.ognl.MyBatisOgnlParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="MyBatisOGNL"
                implementationClass="io.github.ns3154.mybatisassistant.ognl.MyBatisOgnlSyntaxHighlighterFactory"/>
        <multiHostInjector
                implementation="io.github.ns3154.mybatisassistant.ognl.MyBatisOgnlXmlInjector"/>
        <fileBasedIndex implementation="io.github.ns3154.mybatisassistant.index.MyBatisXmlSymbolIndex"/>
        <fileBasedIndex implementation="io.github.ns3154.mybatisassistant.index.MyBatisConfigurationIndex"/>
        <fileBasedIndex implementation="io.github.ns3154.mybatisassistant.index.MyBatisBootConfigurationIndex"/>
        <psi.referenceContributor
                language="XML"
                implementation="io.github.ns3154.mybatisassistant.reference.MyBatisXmlReferenceContributor"/>
        <psi.referenceContributor
                language="JAVA"
                implementation="io.github.ns3154.mybatisassistant.reference.MyBatisJavaReferenceContributor"/>
        <psi.referenceContributor
                language="MyBatisOGNL"
                implementation="io.github.ns3154.mybatisassistant.reference.MyBatisOgnlReferenceContributor"/>
        <completion.contributor
                language="MyBatisOGNL"
                implementationClass="io.github.ns3154.mybatisassistant.ognl.MyBatisOgnlCompletionContributor"/>
        <referencesSearch
                implementation="io.github.ns3154.mybatisassistant.reference.MyBatisXmlReferencesSearchExecutor"/>
        <renamePsiElementProcessor
                implementation="io.github.ns3154.mybatisassistant.refactoring.MyBatisParamRenameProcessor"/>
        <renameHandler
                implementation="io.github.ns3154.mybatisassistant.refactoring.MyBatisParamRenameHandler"/>
        <renamePsiElementProcessor
                implementation="io.github.ns3154.mybatisassistant.refactoring.MyBatisXmlSymbolRenameProcessor"/>
        <renamePsiElementProcessor
                implementation="io.github.ns3154.mybatisassistant.refactoring.MyBatisOgnlBindingRenameProcessor"/>
        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="io.github.ns3154.mybatisassistant.navigation.MyBatisMapperLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider
                language="XML"
                implementationClass="io.github.ns3154.mybatisassistant.navigation.MyBatisXmlLineMarkerProvider"/>
        <localInspection
                language="JAVA"
                shortName="MyBatisMissingStatement"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.missing.statement.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisMissingStatementInspection"/>
        <localInspection
                language="JAVA"
                shortName="MyBatisMissingMapperXml"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.missing.mapper.xml.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisMissingMapperXmlInspection"/>
        <localInspection
                language="JAVA"
                shortName="MyBatisMissingParamAnnotation"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.missing.param.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="false"
                level="WEAK WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisMissingParamAnnotationInspection"/>
        <localInspection
                language="JAVA"
                shortName="MyBatisInvalidAnnotationParameter"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.invalid.annotation.parameter.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisInvalidAnnotationParameterInspection"/>
        <localInspection
                language="XML"
                shortName="MyBatisInvalidNamespace"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.invalid.namespace.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="false"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisInvalidNamespaceInspection"/>
        <localInspection
                language="XML"
                shortName="MyBatisDuplicateStatement"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.duplicate.statement.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisDuplicateStatementInspection"/>
        <localInspection
                language="XML"
                shortName="MyBatisUnusedStatement"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.unused.statement.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="false"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisUnusedStatementInspection"/>
        <localInspection
                language="XML"
                shortName="MyBatisInvalidParameterPath"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.invalid.parameter.path.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisInvalidParameterPathInspection"/>
        <localInspection
                language="XML"
                shortName="MyBatisInvalidResultMapping"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.invalid.result.mapping.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisInvalidResultMappingInspection"/>
        <localInspection
                language="MyBatisOGNL"
                shortName="MyBatisOgnlUnresolvedSymbol"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.ognl.unresolved.symbol.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisOgnlUnresolvedSymbolInspection"/>
        <applicationService
                serviceImplementation="io.github.ns3154.mybatisassistant.settings.MyBatisAssistantSettings"/>
        <projectService
                serviceImplementation="io.github.ns3154.mybatisassistant.database.MyBatisDatabaseMetadataService"/>
        <projectService
                serviceImplementation="io.github.ns3154.mybatisassistant.database.jdbc.MyBatisJdbcDataSourceManager"/>
        <applicationConfigurable
                parentId="tools"
                id="io.github.ns3154.mybatisassistant.settings"
                instance="io.github.ns3154.mybatisassistant.settings.MyBatisAssistantSettingsConfigurable"
                bundle="messages.MyBatisAssistantBundle"
                key="settings.display.name"/>
        <projectConfigurable
                parentId="tools"
                id="io.github.ns3154.mybatisassistant.settings.jdbc"
                instance="io.github.ns3154.mybatisassistant.settings.MyBatisJdbcDataSourcesConfigurable"
                bundle="messages.MyBatisAssistantBundle"
                key="settings.jdbc.display.name"/>
        <notificationGroup
                id="MyBatis Assistant"
                key="notification.group.name"
                displayType="BALLOON"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
    <actions>
        <action
                id="MyBatisAssistant.SqlTool.RestoreLogSql"
                class="io.github.ns3154.mybatisassistant.sqltool.intellij.MyBatisLogSqlRestoreAction"
                text="还原 MyBatis 日志 SQL…"
                description="在本地还原 Preparing/Parameters 日志并标注 SQL 风险，不自动执行">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
                id="MyBatisAssistant.SqlTool.FormatMapperXml"
                class="io.github.ns3154.mybatisassistant.sqltool.intellij.MyBatisXmlFormatAction"
                text="格式化 MyBatis XML…"
                description="预览并以单个可撤销命令格式化当前 MyBatis Mapper XML">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action
                id="MyBatisAssistant.SqlTool.DdlToArtifacts"
                class="io.github.ns3154.mybatisassistant.sqltool.intellij.MyBatisDdlToArtifactsAction"
                text="CREATE TABLE 转 MyBatis 产物…"
                description="在本地预览 DDL 转 Entity、Mapper 和 ResultMap XML">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
                id="MyBatisAssistant.SqlTool.SelectToArtifacts"
                class="io.github.ns3154.mybatisassistant.sqltool.intellij.MyBatisSelectToArtifactsAction"
                text="SELECT 转 MyBatis 产物…"
                description="从显式投影 SELECT 预览 Mapper、XML、ResultMap 和 Java 行模型">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
                id="MyBatisAssistant.SqlTool.JavaToDdl"
                class="io.github.ns3154.mybatisassistant.sqltool.intellij.MyBatisJavaToDdlAction"
                text="Java 类生成 DDL…"
                description="从当前 Java 实体类预览目标方言 DDL，不自动执行">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action
                id="MyBatisAssistant.SqlTool.MapperJUnitSkeleton"
                class="io.github.ns3154.mybatisassistant.sqltool.intellij.MyBatisMapperJUnitSkeletonAction"
                text="生成 Mapper JUnit 测试骨架…"
                description="从当前 Mapper 方法生成 JUnit 4/5 只读测试骨架预览">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action
                id="MyBatisAssistant.SqlTool.MigrateAnnotationSql"
                class="io.github.ns3154.mybatisassistant.sqltool.intellij.MyBatisAnnotationSqlMigrateAction"
                text="迁移注解 SQL 到 XML…"
                description="预览并原子移除内联 MyBatis SQL 注解、写入唯一 Mapper XML">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
