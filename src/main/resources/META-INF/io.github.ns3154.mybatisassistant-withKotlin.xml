<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor
                language="kotlin"
                implementation="io.github.ns3154.mybatisassistant.reference.MyBatisKotlinReferenceContributor"/>
        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="io.github.ns3154.mybatisassistant.navigation.MyBatisKotlinMapperLineMarkerProvider"/>
        <localInspection
                language="kotlin"
                shortName="MyBatisInvalidKotlinAnnotationParameter"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.invalid.annotation.parameter.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisInvalidKotlinAnnotationParameterInspection"/>
        <localInspection
                language="kotlin"
                shortName="MyBatisMissingKotlinStatement"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.missing.statement.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisMissingKotlinStatementInspection"/>
    </extensions>
</idea-plugin>
