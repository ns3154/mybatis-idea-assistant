<idea-plugin>
    <extensions defaultExtensionNs="io.github.ns3154.mybatis-idea-assistant">
        <databaseMetadataProvider
                implementation="io.github.ns3154.mybatisassistant.database.intellij.DatabaseToolsMetadataProvider"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <projectService
                serviceImplementation="io.github.ns3154.mybatisassistant.sql.intellij.MyBatisSqlPsiService"/>
        <projectService
                serviceImplementation="io.github.ns3154.mybatisassistant.database.intellij.DatabaseToolsMetadataInvalidationService"/>
        <multiHostInjector
                implementation="io.github.ns3154.mybatisassistant.sql.intellij.MyBatisSqlXmlInjector"/>
        <completion.contributor
                language="XML"
                order="first"
                implementationClass="io.github.ns3154.mybatisassistant.sql.intellij.MyBatisSqlCompletionContributor"/>
        <completion.contributor
                language="GenericSQL"
                order="first"
                implementationClass="io.github.ns3154.mybatisassistant.sql.intellij.MyBatisSqlCompletionContributor"/>
        <psi.referenceContributor
                language="XML"
                implementation="io.github.ns3154.mybatisassistant.database.intellij.MyBatisDatabaseObjectReferenceContributor"/>
        <referencesSearch
                implementation="io.github.ns3154.mybatisassistant.database.intellij.MyBatisDatabaseObjectReferencesSearchExecutor"/>
        <localInspection
                language="XML"
                shortName="MyBatisSqlSchema"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.sql.schema.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisSqlSchemaInspection"/>
    </extensions>
    <actions>
        <action
                id="MyBatisAssistant.Database.Generate"
                class="io.github.ns3154.mybatisassistant.database.intellij.MyBatisDatabaseGenerateAction">
            <add-to-group group-id="DatabaseViewPopupMenu" anchor="last"/>
        </action>
        <action
                id="MyBatisAssistant.Database.GenerateMethod"
                class="io.github.ns3154.mybatisassistant.database.intellij.MyBatisDatabaseMethodGenerateAction">
            <add-to-group group-id="DatabaseViewPopupMenu" anchor="last"/>
        </action>
        <action
                id="MyBatisAssistant.Database.GenerateWrapper"
                class="io.github.ns3154.mybatisassistant.database.intellij.MyBatisDatabaseWrapperGenerateAction">
            <add-to-group group-id="DatabaseViewPopupMenu" anchor="last"/>
        </action>
        <action
                id="MyBatisAssistant.Database.GenerateJoin"
                class="io.github.ns3154.mybatisassistant.database.intellij.MyBatisDatabaseJoinGenerateAction">
            <add-to-group group-id="DatabaseViewPopupMenu" anchor="last"/>
        </action>
        <action
                id="MyBatisAssistant.Database.ExecuteSql"
                class="io.github.ns3154.mybatisassistant.database.intellij.MyBatisDatabaseSqlExecuteAction">
            <add-to-group group-id="DatabaseViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
