<idea-plugin>
    <id>io.github.ns3154.mybatis-idea-assistant</id>
    <name>MyBatis Assistant</name>
    <vendor url="https://github.com/ns3154/mybatis-idea-assistant">ns3154</vendor>

    <description><![CDATA[
        <p>MyBatis Assistant provides conservative MyBatis navigation, inspection, and incremental semantic models for IntelliJ IDEA.</p>
        <p>当前开发预览版提供双向精确导航、XML/Java 引用、保守检查、安全 Quick Fix，以及 XML 符号、Java/Kotlin Mapper、配置、TypeAlias 和模块可见性的增量语义模型。</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends optional="true" config-file="io.github.ns3154.mybatisassistant-withKotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="io.github.ns3154.mybatisassistant-withSpring.xml">com.intellij.spring</depends>
    <depends optional="true" config-file="io.github.ns3154.mybatisassistant-withYaml.xml">org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="io.github.ns3154.mybatisassistant-withDatabase.xml">com.intellij.database</depends>

    <resource-bundle>messages.MyBatisAssistantBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileBasedIndex implementation="io.github.ns3154.mybatisassistant.index.MyBatisXmlSymbolIndex"/>
        <fileBasedIndex implementation="io.github.ns3154.mybatisassistant.index.MyBatisConfigurationIndex"/>
        <fileBasedIndex implementation="io.github.ns3154.mybatisassistant.index.MyBatisBootConfigurationIndex"/>
        <psi.referenceContributor
                language="XML"
                implementation="io.github.ns3154.mybatisassistant.reference.MyBatisXmlReferenceContributor"/>
        <psi.referenceContributor
                language="JAVA"
                implementation="io.github.ns3154.mybatisassistant.reference.MyBatisJavaReferenceContributor"/>
        <referencesSearch
                implementation="io.github.ns3154.mybatisassistant.reference.MyBatisXmlReferencesSearchExecutor"/>
        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="io.github.ns3154.mybatisassistant.navigation.MyBatisMapperLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider
                language="XML"
                implementationClass="io.github.ns3154.mybatisassistant.navigation.MyBatisXmlLineMarkerProvider"/>
        <localInspection
                language="JAVA"
                shortName="MyBatisMissingStatement"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.missing.statement.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisMissingStatementInspection"/>
        <localInspection
                language="JAVA"
                shortName="MyBatisMissingMapperXml"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.missing.mapper.xml.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisMissingMapperXmlInspection"/>
        <localInspection
                language="JAVA"
                shortName="MyBatisMissingParamAnnotation"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.missing.param.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="false"
                level="WEAK WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisMissingParamAnnotationInspection"/>
        <localInspection
                language="XML"
                shortName="MyBatisInvalidNamespace"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.invalid.namespace.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="false"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisInvalidNamespaceInspection"/>
        <localInspection
                language="XML"
                shortName="MyBatisDuplicateStatement"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.duplicate.statement.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisDuplicateStatementInspection"/>
        <localInspection
                language="XML"
                shortName="MyBatisUnusedStatement"
                bundle="messages.MyBatisAssistantBundle"
                key="inspection.unused.statement.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="false"
                level="WARNING"
                implementationClass="io.github.ns3154.mybatisassistant.inspection.MyBatisUnusedStatementInspection"/>
        <applicationService
                serviceImplementation="io.github.ns3154.mybatisassistant.settings.MyBatisAssistantSettings"/>
        <applicationConfigurable
                parentId="tools"
                id="io.github.ns3154.mybatisassistant.settings"
                instance="io.github.ns3154.mybatisassistant.settings.MyBatisAssistantSettingsConfigurable"
                bundle="messages.MyBatisAssistantBundle"
                key="settings.display.name"/>
        <notificationGroup
                id="MyBatis Assistant"
                key="notification.group.name"
                displayType="BALLOON"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
